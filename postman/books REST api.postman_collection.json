		{
			"name": "/book optimistic-lock",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"const base = pm.environment.get(\"base_url\"); ",
							"const id = pm.environment.get(\"book_id\");    ",
							"",
							"  const book ={ \"name\":\"First Book\", \"author\":\"X\", \"rating\":5}",
							";",
							"  const payloadA = {",
							"    name: \"Update A\",",
							"    author: book.author,",
							"    rating: book.rating",
							"",
							"  };",
							"",
							"  const payloadB = {",
							"    name: \"Update B\",",
							"    author: book.author,",
							"    rating: book.rating",
							"",
							"  };",
							"",
							"  const putReq = (payload) => ({",
							"    url: `${base}/book/${id}`,",
							"    method: \"PUT\",",
							"    header: { \"Content-Type\": \"application/json\" },",
							"    body: { mode: \"raw\", raw: JSON.stringify(payload) }",
							"  });",
							"",
							"// fire two puts without waiting for each other",
							"  pm.sendRequest(putReq(payloadA), (e1, r1) => {",
							"    console.log(\"PUT A status:\", r1.code, r1.text());",
							"  });",
							"",
							"  pm.sendRequest(putReq(payloadB), (e2, r2) => {",
							"    console.log(\"PUT B status:\", r2.code, r2.text());",
							"  });",
							"",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "PUT",
				"header": [],
				"url": {
					"raw": "{{base_url}}/book/{{id}}",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"book",
						"{{id}}"
					]
				}
			},
